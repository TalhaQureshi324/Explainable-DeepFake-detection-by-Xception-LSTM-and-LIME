# ---- Supabase (Phase 4): leave empty to run fully local (SQLite persistence) ----
SUPABASE_URL=
SUPABASE_SERVICE_KEY=      # service-role key: BACKEND ONLY, never in the frontend
SUPABASE_ANON_KEY=         # used by the Next.js frontend for Supabase-mode auth
RETENTION_DAYS=            # empty = keep analyses until user deletion; e.g. 90

# ---- backend ----
DEEPFAKE_MODELS_DIR=models_store
DEEPFAKE_THRESHOLD=0.60
DEEPFAKE_THRESHOLD_VERSION=dev-v1
DEEPFAKE_MAX_UPLOAD_MB=200
DEEPFAKE_MAX_WORKERS=1
DEEPFAKE_ENABLE_XAI=false
DEEPFAKE_LIME_SAMPLES=80

# ---- frontend (build-time) ----
INFERENCE_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_MAX_UPLOAD_MB=200
